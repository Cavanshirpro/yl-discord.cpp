@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(CURL 7.86)
find_dependency(nlohmann_json 3.11)
include("${CMAKE_CURRENT_LIST_DIR}/ylDiscordAsio.cmake")
if(NOT TARGET asio::asio)
    set(ylDiscord_FOUND FALSE)
    set(ylDiscord_NOT_FOUND_MESSAGE "Standalone Asio >= 1.30.2 is required. Install Asio or set YL_DISCORD_ASIO_INCLUDE_DIR.")
    return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/ylDiscordTargets.cmake")
check_required_components(ylDiscord)
